ARG BASE_IMAGE=debian:13
FROM ${BASE_IMAGE}

ARG DISTRO=debian13
ARG TARGET=x86_64-unknown-linux-gnu
ARG RUST_TOOLCHAIN=stable
ARG RDEV_DISABLE_ASM=
ARG CARGO_REGISTRY=
ARG RUSTUP_DIST_SERVER=
ARG RUSTUP_UPDATE_ROOT=

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    PATH=/root/.cargo/bin:/opt/rh/devtoolset-10/root/usr/bin:/opt/rh/devtoolset-9/root/usr/bin:$PATH \
    RDEV_GPU_INSTALL_DEPS=n

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux; \
    case "$DISTRO" in centos7|centos8) export RDEV_DISABLE_ASM="${RDEV_DISABLE_ASM:-y}" ;; esac; \
    if command -v apt-get >/dev/null 2>&1; then \
      pipewire_deps=""; \
      case "$DISTRO" in debian13|ubuntu*) pipewire_deps="libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev gstreamer1.0-pipewire gstreamer1.0-plugins-base gstreamer1.0-plugins-good pipewire xdg-desktop-portal" ;; esac; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential pkg-config nasm yasm python3 make \
        autoconf automake libtool \
        libx11-dev libx11-xcb-dev libxext-dev libxrandr-dev libxfixes-dev libxcomposite-dev libxi-dev libxtst-dev libxv-dev \
        libxcb1-dev libxcb-dri3-dev libdrm-dev libepoxy-dev libdbus-1-dev \
        $pipewire_deps; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v yum >/dev/null 2>&1; then \
      asm_deps="nasm yasm"; \
      if [ "${RDEV_DISABLE_ASM:-n}" = "y" ]; then asm_deps=""; fi; \
      case "$(uname -m)" in aarch64|arm64) asm_deps="" ;; esac; \
      if [ -f /etc/centos-release ] && grep -q ' 7\.' /etc/centos-release; then \
        sed -i 's|^mirrorlist=|#mirrorlist=|g; s|^#baseurl=http://mirror.centos.org/centos/$releasever|baseurl=http://vault.centos.org/7.9.2009|g' /etc/yum.repos.d/CentOS-*.repo || true; \
        yum install -y centos-release-scl epel-release || true; \
        rm -f /etc/yum.repos.d/CentOS-SCLo-*.repo; \
        printf '%s\n' \
          '[centos-sclo-sclo]' \
          'name=CentOS-7 - SCLo sclo' \
          'baseurl=https://vault.centos.org/7.9.2009/sclo/$basearch/sclo/' \
          'gpgcheck=1' \
          'enabled=1' \
          'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-SCLo' \
          > /etc/yum.repos.d/CentOS-SCLo-sclo.repo; \
        printf '%s\n' \
          '[centos-sclo-rh]' \
          'name=CentOS-7 - SCLo rh' \
          'baseurl=https://vault.centos.org/7.9.2009/sclo/$basearch/rh/' \
          'gpgcheck=1' \
          'enabled=1' \
          'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-SCLo' \
          > /etc/yum.repos.d/CentOS-SCLo-rh.repo; \
        yum install -y devtoolset-10-gcc devtoolset-10-gcc-c++ devtoolset-10-binutils || true; \
      else \
        yum install -y epel-release || true; \
      fi; \
      yum install -y \
        ca-certificates curl git make pkgconfig python3 \
        autoconf automake libtool \
        gcc gcc-c++ clang \
        $asm_deps \
        libX11-devel libxcb-devel libXext-devel libXrandr-devel libXfixes-devel libXcomposite-devel libXi-devel libXtst-devel libXv-devel \
        libdrm-devel libepoxy-devel dbus-devel; \
      yum clean all || true; \
    elif command -v dnf >/dev/null 2>&1; then \
      dnf install -y epel-release || true; \
      asm_deps="nasm yasm"; \
      if [ "${RDEV_DISABLE_ASM:-n}" = "y" ]; then asm_deps=""; fi; \
      case "$(uname -m)" in aarch64|arm64) asm_deps="" ;; esac; \
      dnf install -y \
        ca-certificates curl git make pkgconf-pkg-config python3 \
        autoconf automake libtool \
        gcc gcc-c++ clang \
        $asm_deps \
        libX11-devel libxcb-devel libXext-devel libXrandr-devel libXfixes-devel libXcomposite-devel libXi-devel libXtst-devel libXv-devel \
        libdrm-devel libepoxy-devel dbus-devel; \
      dnf clean all || true; \
    else \
      echo "unsupported package manager" >&2; exit 1; \
    fi

RUN set -eux; \
    if [ -n "$RUSTUP_DIST_SERVER" ]; then export RUSTUP_DIST_SERVER; fi; \
    if [ -n "$RUSTUP_UPDATE_ROOT" ]; then export RUSTUP_UPDATE_ROOT; fi; \
    curl -fSL --retry 5 --retry-delay 5 https://sh.rustup.rs -o /tmp/rustup-init.sh; \
    sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN" --target "$TARGET"; \
    rm -f /tmp/rustup-init.sh; \
    if [ -n "$CARGO_REGISTRY" ]; then \
      mkdir -p "$CARGO_HOME"; \
      printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "rdev-mirror"' \
        '' \
        '[source.rdev-mirror]' \
        "registry = \"$CARGO_REGISTRY\"" \
        > "$CARGO_HOME/config.toml"; \
    fi; \
    rustc --version; cargo --version

WORKDIR /work
